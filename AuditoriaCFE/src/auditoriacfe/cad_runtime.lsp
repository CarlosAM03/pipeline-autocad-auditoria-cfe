; DATRA CFE - runtime versionado. Solo actua sobre copia de DWG exacta.
; Simbolos ESQUEMATICOS. No certifica CRS, materiales, DWT ni impresion.
(setq datra:*ready* nil datra:*height* 1.8)

(defun datra:fail (message)
  (setq datra:*failure* message)
  (exit))

(defun datra:guard (expected / actual)
  (setq actual (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
  (if (/= (strcase (vl-string-translate "\\" "/" actual))
          (strcase (vl-string-translate "\\" "/" expected)))
    (datra:fail "DATRA: abra unicamente la COPIA indicada en el reporte CAD")))

(defun datra:run (fn / result)
  (setq datra:*ready* nil datra:*failure* nil)
  (command-s "_.UNDO" "_Begin")
  (setq result (vl-catch-all-apply fn nil))
  (command-s "_.UNDO" "_End")
  (if (vl-catch-all-error-p result)
    (progn (setq datra:*ready* nil)
      (command-s "_.U")
      (alert (strcat "DATRA FALLIDO: " (if datra:*failure* datra:*failure* (vl-catch-all-error-message result))
        ". Grupo deshecho. No guardar como FINAL; revisar reporte."))))
  (princ))

(defun datra:layer (name color)
  (if (not (tblsearch "LAYER" name))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
       '(100 . "AcDbLayerTableRecord") (cons 2 name) '(70 . 0)
       (cons 62 color) '(6 . "Continuous")))))

(defun datra:block (name kind)
  (if (not (tblsearch "BLOCK" name))
    (progn
      (entmake (list '(0 . "BLOCK") (cons 2 name) '(70 . 0) '(10 0.0 0.0 0.0)))
      (cond
        ((= kind "CAJA_EMP")
          (entmake '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (8 . "0")
            (100 . "AcDbPolyline") (90 . 4) (70 . 1)
            (10 -0.45 -0.45) (10 0.45 -0.45) (10 0.45 0.45) (10 -0.45 0.45))))
        (T (entmake '((0 . "CIRCLE") (8 . "0") (10 0.0 0.0 0.0) (40 . 0.45)))))
      (if (= kind "EXCEDENTE")
        (entmake '((0 . "LINE") (8 . "0") (10 -0.65 0.0 0.0) (11 0.65 0.0 0.0))))
      (entmake '((0 . "ENDBLK"))))))

(defun datra:layouts (/ result)
  (foreach item (entget (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_LAYOUT"))))
    (if (= (car item) 3) (setq result (cons (cdr item) result))))
  result)

(defun datra:layout-entity (name)
  (cdr (assoc -1 (dictsearch
    (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_LAYOUT"))) name))))

(defun datra:plot-settings (data settings / active result pair)
  (foreach pair data
    (if (= (car pair) 100) (setq active (= (cdr pair) "AcDbPlotSettings")))
    (if (and active (assoc (car pair) settings)) (setq pair (assoc (car pair) settings)))
    (setq result (cons pair result)))
  (reverse result))

(defun datra:layout (name / lay data)
  ; Copiar el layout de marco existente, nunca reconstruir Tijuana.
  (if (not (member name (datra:layouts)))
    (if (member "Layout1" (datra:layouts))
      (command "_.-LAYOUT" "_Copy" "Layout1" name)
      (datra:fail "Falta Layout1 de la base DATRA: acreditar perfil de plantilla")))
  (setq lay (datra:layout-entity name) data (entget lay))
  (if (not (and (equal (cdr (assoc 44 data)) 841.0 0.1)
                (equal (cdr (assoc 45 data)) 594.0 0.1)))
    (datra:fail "Perfil de papel de base no es A1 horizontal: acreditar plantilla"))
  (if (not (entmod (datra:plot-settings data
    '((72 . 1) (73 . 0) (74 . 5) (75 . 16) (142 . 1.0) (143 . 1.0) (147 . 1.0)))))
    (datra:fail "No se pudieron configurar unidades/escala de layout"))
  (setvar "CTAB" name)
  lay)

(defun datra:configure (expected owner layout mode meters / lay)
  (datra:guard expected)
  (setq datra:*owner* owner datra:*layout* layout datra:*mode* mode)
  (foreach pair '(("DATRA_POSTE" . 1) ("DATRA_CAJA_EMP" . 3) ("DATRA_EXCEDENTE" . 5)
                  ("DATRA_TEXTO" . 7) ("DATRA_RUTA" . 2) ("DATRA_DISTANCIA" . 4)
                  ("DATRA_CONTROL" . 6))
    (datra:layer (car pair) (cdr pair)))
  (if (not (tblsearch "STYLE" "DATRA_SIMPLE_V1"))
    (entmake '((0 . "STYLE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbTextStyleTableRecord")
       (2 . "DATRA_SIMPLE_V1") (70 . 0) (40 . 0.0) (41 . 1.0) (50 . 0.0)
       (71 . 0) (42 . 2.5) (3 . "txt.shx") (4 . ""))))
  (datra:block "DATRA_POSTE_V1" "POSTE")
  (datra:block "DATRA_CAJA_EMP_V1" "CAJA_EMP")
  (datra:block "DATRA_EXCEDENTE_V1" "EXCEDENTE")
  (if meters (setvar "INSUNITS" 6))
  (setvar "LUNITS" 2)
  (regapp "DATRA_CFE")
  (datra:layout layout)
  (setq datra:*ready* T)
  (princ "\nDATRA CP03: configurado. Base y mapa conservados; requiere revision nativa A1."))

(defun datra:tag (entity id / data)
  (if (not entity) (datra:fail "No se pudo crear entidad CAD"))
  (setq data (entget entity))
  (entmod (append data (list (list -3 (list "DATRA_CFE" (cons 1000 datra:*owner*) (cons 1000 id))))))
  entity)

(defun datra:make (data)
  ; entmake asigna propietario del espacio actual; no entmakex huerfano.
  (if (not (entmake data)) (datra:fail "entmake no creo entidad"))
  (entlast))

(defun datra:owned (entity / x)
  (setq x (assoc -3 (entget entity '("DATRA_CFE"))))
  (and x (= datra:*owner* (cdr (assoc 1000 (cdr (cadr x)))))))

(defun datra:begin (expected owner layout mode / sel i entity)
  (datra:guard expected)
  (if (or (not (tblsearch "BLOCK" "DATRA_POSTE_V1"))
          (not (tblsearch "STYLE" "DATRA_SIMPLE_V1"))
          (not (member layout (datra:layouts))))
    (datra:fail "Ejecute primero SCR01 en esta copia"))
  (setq datra:*owner* owner datra:*layout* layout datra:*mode* mode
        datra:*points* 0 datra:*edges* 0 datra:*ready* T)
  (regapp "DATRA_CFE")
  (setq sel (ssget "_X" '((-3 ("DATRA_CFE")))))
  (if sel
    (progn (setq i 0)
      (repeat (sslength sel)
        (setq entity (ssname sel i) i (1+ i))
        (if (datra:owned entity) (entdel entity)))))
  (setvar "CTAB" "Model"))

(defun datra:text (id layer point height value paper / entity)
  (if paper (setvar "CTAB" datra:*layout*))
  (setq entity (datra:make (list '(0 . "TEXT") (cons 8 layer)
    (cons 10 point) (cons 40 height) (cons 1 value) '(7 . "DATRA_SIMPLE_V1")
    (cons 67 (if paper 1 0)) (cons 410 (if paper datra:*layout* "Model")))))
  (datra:tag entity id))

(defun datra:point (id block kind x y label geo / entity h)
  (if (not datra:*ready*) (datra:fail "Sesion DATRA no habilitada"))
  (setq h datra:*height*)
  (setq entity (datra:make (list '(0 . "INSERT") (cons 2 block) (cons 8 (strcat "DATRA_" kind))
     (list 10 x y 0.0) (cons 41 h) (cons 42 h) (cons 43 h) '(67 . 0) '(410 . "Model"))))
  (datra:tag entity id)
  (datra:text id "DATRA_TEXTO" (list (+ x h) (+ y h) 0.0) h label nil)
  (datra:text id "DATRA_TEXTO" (list (+ x h) (- y h) 0.0) (* h 0.65) geo nil)
  (setq datra:*points* (1+ datra:*points*)))

(defun datra:edge (id x1 y1 x2 y2 label / entity)
  (if (not datra:*ready*) (datra:fail "Sesion DATRA no habilitada"))
  (setq entity (datra:make (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity")
    '(8 . "DATRA_RUTA") '(67 . 0) '(410 . "Model") '(100 . "AcDbPolyline")
    '(90 . 2) '(70 . 0) (list 10 x1 y1) (list 10 x2 y2))))
  (datra:tag entity id)
  (datra:text id "DATRA_DISTANCIA" (list (/ (+ x1 x2) 2.0) (/ (+ y1 y2) 2.0) 0.0)
    (* datra:*height* 0.8) label nil)
  (setq datra:*edges* (1+ datra:*edges*)))

(defun datra:finish (file points edges counts / stream selection actual i e d actualtypes p c x actualedges)
  (if (or (/= points datra:*points*) (/= edges datra:*edges*))
    (datra:fail "Conteos de insercion no coinciden"))
  (setq actual 0 p 0 c 0 x 0 actualedges 0
        selection (ssget "_X" '((0 . "INSERT") (-3 ("DATRA_CFE")))))
  (if selection
    (progn (setq i 0)
      (repeat (sslength selection)
        (setq e (ssname selection i) i (1+ i))
        (if (datra:owned e)
          (progn (setq actual (1+ actual) d (cdr (assoc 2 (entget e))))
            (cond ((= d "DATRA_POSTE_V1") (setq p (1+ p)))
                  ((= d "DATRA_CAJA_EMP_V1") (setq c (1+ c)))
                  ((= d "DATRA_EXCEDENTE_V1") (setq x (1+ x)))))))))
  (if (/= actual points) (datra:fail "Conteo real de bloques DATRA no coincide"))
  (if (not (equal counts (list p c x))) (datra:fail "Conteos reales por tipo no coinciden"))
  (setq selection (ssget "_X" '((0 . "LWPOLYLINE") (8 . "DATRA_RUTA") (-3 ("DATRA_CFE")))))
  (if selection
    (progn (setq i 0)
      (repeat (sslength selection)
        (if (datra:owned (ssname selection i)) (setq actualedges (1+ actualedges)))
        (setq i (1+ i)))))
  (if (/= edges actualedges) (datra:fail "Conteo real de aristas no coincide"))
  (datra:text "ESTADO" "DATRA_CONTROL" '(150.0 585.0 0.0) 3.0 datra:*mode* T)
  (datra:text "CONTEOS" "DATRA_CONTROL" '(150.0 580.0 0.0) 2.5
    (strcat "Componentes dibujados: " (itoa actual) " / Aristas: " (itoa edges)) T)
  (datra:text "TIPOS" "DATRA_CONTROL" '(150.0 575.0 0.0) 2.0
    (strcat "POSTE: " (itoa p) " | CAJA_EMP: " (itoa c) " | EXCEDENTE: " (itoa x)) T)
  (datra:text "PROTOTIPO" "DATRA_CONTROL" '(150.0 570.0 0.0) 2.0
    "SIMBOLOS ESQUEMATICOS - MATERIALES NO HOMOLOGADOS - REVISION HUMANA PENDIENTE" T)
  (setq stream (open file "w"))
  (if (not stream) (datra:fail "No se pudo escribir evidencia nativa"))
  (write-line (strcat "modo=" datra:*mode*) stream)
  (write-line (strcat "bloques_insertados=" (itoa actual)) stream)
  (write-line (strcat "aristas=" (itoa edges)) stream)
  (write-line (strcat "POSTE=" (itoa p) ";CAJA_EMP=" (itoa c) ";EXCEDENTE=" (itoa x)) stream)
  (write-line (strcat "INSUNITS=" (itoa (getvar "INSUNITS"))) stream)
  (write-line "CRS/legibilidad/FINAL=REQUIERE_APROBACION_HUMANA" stream)
  (close stream)
  (setq datra:*ready* nil))

(defun datra:put (data code value)
  (if (assoc code data) (subst (cons code value) (assoc code data) data)
    (append data (list (cons code value)))))

(defun datra:viewport (xmin ymin xmax ymax / sel i obj old scale area data id result)
  ; Reutilizar viewport principal existente; no superponer un segundo mapa.
  ; Los viewports secundarios de detalles heredados requieren revision nativa.
  (setq old nil area 0.0 id 2 i 0)
  (setvar "CTAB" datra:*layout*)
  (setq sel (ssget "_X" (list '(0 . "VIEWPORT") (cons 410 datra:*layout*))))
  (if sel
    (repeat (sslength sel)
      (setq obj (ssname sel i) i (1+ i) data (entget obj) id (max id (1+ (cdr (assoc 69 data)))))
      (if (and (> (cdr (assoc 69 data)) 1) (> (cdr (assoc 40 data)) 100.0)
               (> (* (cdr (assoc 40 data)) (cdr (assoc 41 data))) area))
        (setq old obj area (* (cdr (assoc 40 data)) (cdr (assoc 41 data)))))))
  (setq scale (* 1.1 (max (/ (- xmax xmin) 530.0) (/ (- ymax ymin) 490.0) 0.01)))
  (setq data (if old (entget old)
    (list '(0 . "VIEWPORT") '(100 . "AcDbEntity") '(67 . 1) (cons 410 datra:*layout*)
      '(8 . "DATRA_CONTROL") '(100 . "AcDbViewport") (cons 69 id))))
  (foreach pair (list '(10 410.0 315.0 0.0) '(40 . 530.0) '(41 . 490.0) '(68 . 1)
      '(12 0.0 0.0) '(16 0.0 0.0 1.0)
      (list 17 (/ (+ xmin xmax) 2.0) (/ (+ ymin ymax) 2.0) 0.0)
      (cons 45 (* 490.0 scale)) '(51 . 0.0) '(90 . 16384))
    (setq data (datra:put data (car pair) (cdr pair))))
  (if old
    (progn (if (not (entmod data)) (datra:fail "Viewport no actualizado")) (setq result old))
    (setq result (datra:make data)))
  (datra:tag result "VIEWPORT")
  (command "_.REGENALL"))

(defun datra:inspect (expected file / stream lay data b selection)
  (datra:guard expected)
  (setq stream (open file "w"))
  (foreach variable '("DWGNAME" "DWGPREFIX" "INSUNITS" "UCSNAME" "WORLDUCS" "UCSORG" "UCSXDIR" "UCSYDIR" "CTAB" "TILEMODE")
    (write-line (strcat variable "=" (vl-princ-to-string (getvar variable))) stream))
  (foreach lay (datra:layouts)
    (setq data (entget (datra:layout-entity lay)))
    (write-line (strcat "LAYOUT=" lay ";MEDIA=" (cdr (assoc 4 data))
      ";DEVICE=" (cdr (assoc 2 data)) ";ROTATION=" (itoa (cdr (assoc 73 data)))) stream))
  (foreach table '("BLOCK" "LAYER" "STYLE")
    (setq b (tblnext table T))
    (while b (write-line (strcat table "=" (vl-princ-to-string b)) stream) (setq b (tblnext table))))
  (setq selection (ssget "_X" '((0 . "IMAGE,PDFUNDERLAY,DGNUNDERLAY,DWFUNDERLAY"))))
  (write-line (strcat "REFERENCIAS_RASTER_UNDERLAY=" (itoa (if selection (sslength selection) 0))) stream)
  (write-line "VERIFICAR_MANUALMENTE=logo,mapa,TENSION,SUSPENSION,DERIVACION,EMPALME,OTROS,fuentes,imagenes,escala,A1" stream)
  (close stream) (princ))

(defun c:DATRACONTROLES (/ p file stream)
  (if (not datra:*owner*) (datra:fail "Ejecute SCR01 sobre copia antes de capturar controles"))
  (setq file (strcat (getvar "DWGPREFIX") "controles_WCS_pendientes.txt") stream (open file "a"))
  (repeat 2
    (setq p (getpoint "\nSeleccione control fisico acreditable, distinto del anterior: "))
    (if (not p) (datra:fail "Captura cancelada"))
    (write-line (vl-princ-to-string (trans p 1 0)) stream))
  (close stream)
  (alert "Complete WGS84, evidencia, fecha, responsable y tolerancia en configuracion. Esta captura NO aprueba el CRS.")
  (princ))
(princ)
